# ─── Core ─────────────────────────────────────────────
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local: docker compose up -d   ·   Prod: MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/haritaabha?replicaSet=rs0&directConnection=true

# ─── Auth (Better Auth) ───────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (optional in dev — Google button hides when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Razorpay (optional in dev — mock payment when empty) ─
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Shiprocket (optional in dev — mock shipping when empty) ─
SHIPROCKET_EMAIL=
# Wrap in single quotes if it starts with # or contains $, and write each $ as \$ (local .env only — not on Vercel)
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
# Token Shiprocket sends in the x-api-key header of tracking webhooks (you choose it)
SHIPROCKET_WEBHOOK_TOKEN=

# ─── ImageKit (optional in dev — uploads saved to /public/uploads when empty) ─
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# ─── Analytics (optional) ─────────────────────────────
NEXT_PUBLIC_GA_ID=

# ─── Seed / first admin ───────────────────────────────
ADMIN_EMAIL=admin@haritaabha.local
ADMIN_PASSWORD=change-me-please

# ─── Staging only ─────────────────────────────────────
# Allow mock payments/shipping in a production build (staging demo before KYC). NEVER set on the live site.
ALLOW_MOCK_INTEGRATIONS=false
